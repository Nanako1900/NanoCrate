# NanoCrate 后端环境变量(docs/backend.md §6)。启动时缺必填项即 fail-fast。
# 复制为 .env 即可本地开发(make run 会自动生成)。绝不提交真实密钥。

APP_ENV=development
HTTP_PORT=8080

# Postgres(docker-compose 默认)
DATABASE_URL=postgres://nano:nano@localhost:5432/nanocrate?sslmode=disable

# Keycloak(OIDC Resource Server:仅验签 JWT)
KEYCLOAK_ISSUER=http://localhost:8081/realms/nanocrate
KEYCLOAK_JWKS_URL=http://localhost:8081/realms/nanocrate/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=nanocrate-api

# Stripe(Phase 2,本阶段留空)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# NATS(Phase 3 事件总线)
NATS_URL=nats://localhost:4222

# 可观测性:OTLP/gRPC trace 导出(→ docker-compose 的 Jaeger)。留空则不导出。
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

# CORS:凭证式跨源白名单(逗号分隔;docs §9.2.1)。绝不用 *。
CORS_ALLOWED_ORIGINS=http://localhost:5173

# SMTP(Notifier):Host 留空则用 LogNotifier(只记日志)。dev 可用 mailpit/mailhog:1025。
SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@nanocrate.local

# Worker 指标暴露端口(Prometheus 抓取)
WORKER_METRICS_ADDR=:9091
