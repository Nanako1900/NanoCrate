# --- NanoCrate frontend environment ---
# Copy to .env.local and adjust. Vite only exposes vars prefixed with VITE_.

# API mode: "mock" (MSW, no backend needed) | "live" (real backend)
VITE_API_MODE=mock

# Base URL of the backend REST API (only used when VITE_API_MODE=live).
# Must match backend.md §9 base path.
VITE_API_BASE_URL=http://localhost:8080/api/v1
